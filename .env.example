# ── Público (browser) ──
NEXT_PUBLIC_SITE_URL=         # opcional — URL pública do site (ex.: https://seu.app)
NEXT_PUBLIC_ADMIN_URL=        # opcional — SÓ se o admin tiver subdomínio próprio
                              # (ex.: https://admin.seudominio.com.br). Vazio = admin
                              # no mesmo domínio, em /login (caso Vercel).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Servidor (NUNCA expor / sem prefixo NEXT_PUBLIC_) ──
SUPABASE_SERVICE_ROLE_KEY=
SESSION_SECRET=            # assinatura de cookie/device fingerprint (>=16 chars)
RESEND_API_KEY=           # envio de OTP por email
OTP_PEPPER=               # pepper extra no hash do OTP (>=8 chars)
WHATSAPP_PHONE=5511999999999   # destino do wa.me (E.164 sem '+')
RATE_LIMIT_REDIS_URL=     # opcional (Upstash) — vazio = rate limit em memória
ADMIN_SUBDOMAIN_ENABLED=  # "1" liga o roteamento admin.<dominio> (Hostinger).
                          # Vazio/0 = admin no mesmo domínio (Vercel).
